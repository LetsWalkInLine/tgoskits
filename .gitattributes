# Normalize all text files to LF in the repository and in the working tree.
* text=auto eol=lf

# Keep Windows-native scripts on CRLF so they remain convenient to run locally.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Treat common binary assets as binary to avoid accidental normalization.
*.bin binary
*.dbg binary
*.dll binary
*.dylib binary
*.elf binary
*.exe binary
*.gif binary
*.gz binary
*.ico binary
*.img binary
*.jar binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.so binary
*.tar binary
*.wasm binary
*.woff binary
*.woff2 binary
*.zip binary
